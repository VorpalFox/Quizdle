{
  "name": "quizdle",
  "version": "1.0.0",
  "description": "Bot Discord de quiz façon Pokédle, avec un moteur indépendant des sujets",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "node dist/deployCommands.js",
    "fetch:pokemon": "tsx scripts/fetchPokemon.ts",
    "fetch:anime": "tsx scripts/fetchAnime.ts",
    "fetch:weebdle": "tsx scripts/fetchWeebdle.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
