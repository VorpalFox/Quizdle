# Discord Developer Portal > ton appli > Bot > Reset Token
DISCORD_TOKEN=
# Discord Developer Portal > ton appli > General Information > Application ID
DISCORD_CLIENT_ID=
# Optionnel : ID de ton serveur (clic droit > Copier l'identifiant) pour que /quiz apparaisse tout de suite
DISCORD_GUILD_ID=
# ID du salon de debug sur ce serveur (clic droit sur le salon > Copier l'identifiant) : /quizdebug ne marche que là
DISCORD_DEBUG_CHANNEL_ID=
